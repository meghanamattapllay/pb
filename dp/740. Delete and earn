class Solution:
    def deleteAndEarn(self, nums: List[int]) -> int:
        m=max(nums)
        points=[0]*(m+1)
        for x in nums:
            points[x]+=x
        dp=[0]*(m+1)
        dp[0]=0
        dp[1]=points[1]
        for i in range(2,m+1):
            dp[i]=max(dp[i-1],dp[i-2]+points[i])
        return dp[m]
