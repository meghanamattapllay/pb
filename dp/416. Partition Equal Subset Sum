class Solution:
    def canPartition(self, nums: List[int]) -> bool:
        s=sum(nums)
        if s%2:
            return False
        t=s//2
        dp=[False]*(t+1)
        dp[0]=True
        for i in nums:
            for j in range(t,i-1,-1):
                dp[j]=dp[j] or dp[j-i]
        return dp[t]
