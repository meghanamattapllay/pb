n=int(input())
a=[]
while len(a)<n:
    a+=list(map(int,input().split()))
ans=False
for m in range(1<<n):
    s=0
    for i in range(n):
        if m&(1<<i):
            s+=a[i]
        else:
            s-=a[i]
    if s%360==0:
        ans=True
        break
if ans:
    print("YES")
else:
    print("NO")
