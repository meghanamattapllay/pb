class Solution:
    def mincostTickets(self, days: List[int], costs: List[int]) -> int:
        n=len(days)
        dp=[0]*(n+1)
        for i in range(1,n+1):
            dp[i]=dp[i-1]+costs[0]
            j=i
            while j>0 and days[j-1]>=days[i-1]-6:
                j-=1
            dp[i]=min(dp[i],dp[j]+costs[1])
            j=i
            while j>0 and days[j-1]>=days[i-1]-29:
                j-=1
            dp[i]=min(dp[i],dp[j]+costs[2])
        return dp[n]
