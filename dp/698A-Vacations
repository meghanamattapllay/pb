n=int(input())
a=list(map(int,input().split()))
dp=[[10**9]*3 for i in range(n+1)]
dp[0]=[0,0,0]
for i in range(1,n+1):
    x=a[i-1]
    dp[i][0]=min(dp[i-1])+1
    if x==1 or x==3:
        dp[i][1]=min(dp[i-1][0],dp[i-1][2])
    if x==2 or x==3:
        dp[i][2]=min(dp[i-1][0],dp[i-1][1])
print(min(dp[n]))
