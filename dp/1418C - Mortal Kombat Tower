t=int(input())
for i in range(t):
    n=int(input())
    a=list(map(int,input().split()))
    dp=[[10**9]*2 for j in range(n+2)]
    dp[n][0]=dp[n][1]=0
    dp[n+1][0]=dp[n+1][1]=0
    for i in range(n-1,-1,-1):
        dp[i][0]=min(a[i]+dp[i+1][1],a[i]+(a[i+1] if i+1<n else 0)+dp[i+2][1])
        dp[i][1]=min(dp[i+1][0],dp[i+2][0])
    print(dp[0][0])
