t=int(input())
for i in range(t):
    n=int(input())
    w=list(map(int,input().split()))
    c=[0]*(n+1)
    for i in w:
        c[i]+=1
    ans=0
    for s in range(2,2*n+1):
        teams=0
        for a in range(1,n+1):
            b=s-a
            if b<1 or b>n:
                continue
            if a==b:
                teams+=c[a]//2
            elif a<b:
                teams+=min(c[a],c[b])
        ans=max(ans,teams)
    print(ans)
